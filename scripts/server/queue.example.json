{
  "name": "tesis_familia_ppo_ejemplo",
  "steps": [
    {
      "name": "check_regmc",
      "module": "showdown.inference_sim.validate_regmc_teams",
      "args": []
    },
    {
      "name": "preview_ppo_live",
      "module": "showdown.rl.team_preview_ppo.train",
      "args": ["--seed", "0", "--updates", "10",
               "--backend", "live", "--num-workers", "{num_envs}", "--start-ps",
               "--device", "{device}", "--checkpoint-dir", "{run_dir}/preview_ppo"],
      "timeout_h": 48
    },
    {
      "name": "ddqn_combate",
      "module": "showdown.rl.ddqn.train",
      "args": ["--seed", "0", "--opponent", "curriculum", "--start-ps",
               "--num-envs", "{num_envs}", "--envs-per-server", "4",
               "--device", "{device}", "--checkpoint-dir", "{run_dir}/ddqn",
               "--preview-checkpoint", "{run_dir}/preview_ppo/final.pt", "--require-preview"],
      "timeout_h": 72
    },
    {
      "name": "ppo_combate",
      "module": "showdown.rl.ppo.train",
      "args": ["--seed", "0", "--opponent", "curriculum", "--start-ps",
               "--num-envs", "{num_envs}", "--envs-per-server", "4",
               "--device", "{device}", "--checkpoint-dir", "{run_dir}/ppo",
               "--preview-checkpoint", "{run_dir}/preview_ppo/final.pt", "--require-preview"],
      "timeout_h": 72
    }
  ]
}
