#--- parameters for the XOR-2 experiment ---#

[NEAT]
fitness_criterion     = max
fitness_threshold     = 1000000
pop_size              = 6
reset_on_extinction   = False

[DefaultGenome]
# node activation options
activation_default      = relu
activation_mutate_rate  = 0.02
activation_options      = relu

# node aggregation options
aggregation_default     = sum
aggregation_mutate_rate = 0.005
aggregation_options     = sum

# node bias options
bias_init_mean          = 0.0
bias_init_stdev         = 1.0
bias_max_value          = 30.0
bias_min_value          = -30.0
bias_mutate_power       = 0.5
bias_mutate_rate        = 0.2
bias_replace_rate       = 0.2

# genome compatibility options
compatibility_disjoint_coefficient = 1.0
compatibility_weight_coefficient   = 0.5

# connection add/remove rates
conn_add_prob           = 0.3
conn_delete_prob        = 0.15

# connection enable options
enabled_default         = True
enabled_mutate_rate     = 0.005

feed_forward            = True
initial_connection      = full

# node add/remove rates
node_add_prob           = 0.3
node_delete_prob        = 0.15

# network parameters
num_hidden              = 0
num_inputs              = 219
num_outputs             = 219

# node response options
response_init_mean      = 0.0
response_init_stdev     = 1.0
response_max_value      = 30.0
response_min_value      = -30.0
response_mutate_power   = 0.5
response_mutate_rate    = 0.2
response_replace_rate   = 0.2

# connection weight options
weight_init_mean        = 0.0
weight_init_stdev       = 1.0
weight_max_value        = 30
weight_min_value        = -30
weight_mutate_power     = 0.5
weight_mutate_rate      = 0.2
weight_replace_rate     = 0.2

[DefaultSpeciesSet]
compatibility_threshold = 2.0

[DefaultStagnation]
species_fitness_func = max
# Valor no usado... Siempre va a haber 8 genomas
max_stagnation       = 200
# Siempre se conservan las 8 genomas
species_elitism      = 6

[DefaultReproduction]
# Ninguna especie es preservada de la anterior generación, 0
elitism            = 3
survival_threshold = 0.2